{
  "kind": "collectionType",
  "collectionName": "solutions",
  "info": {
    "singularName": "solution",
    "pluralName": "solutions",
    "displayName": "Solution",
    "description": "Products shown on /products, in 'order' (lowest first)."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "heading": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 120
    },
    "tagline": {
      "type": "string",
      "maxLength": 240
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "paragraphs": {
      "type": "component",
      "repeatable": true,
      "component": "content.paragraph"
    },
    "points": {
      "type": "component",
      "repeatable": true,
      "component": "content.point"
    },
    "badge": {
      "type": "string",
      "maxLength": 120
    },
    "buttonLabel": {
      "type": "string",
      "maxLength": 60
    },
    "buttonLink": {
      "type": "string",
      "maxLength": 2000
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 9999
    }
  }
}
