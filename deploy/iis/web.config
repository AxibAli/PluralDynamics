<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site for the Plural Dynamics Node.js app (reverse proxy).
  Requires the IIS "URL Rewrite" and "Application Request Routing" (ARR, proxy enabled) modules.
  The app itself runs as a Windows service on 127.0.0.1:3001 (see install-service.ps1).
  Serves pluraldynamics.com (live), www.pluraldynamics.com (redirects to the live domain)
  and staging.pluraldynamics.com (kept out of search engines).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- win-acme (SSL) puts its validation files here; IIS must serve them itself. -->
        <rule name="AcmeChallenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>

        <!-- www.pluraldynamics.com -> https://pluraldynamics.com (one address for Google). -->
        <rule name="WwwToApex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.pluraldynamics\.com$" />
          </conditions>
          <action type="Redirect" url="https://pluraldynamics.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- http -> https (only once the certificate is installed; see README). -->
        <rule name="ForceHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^off$" />
            <add input="{HTTP_HOST}" pattern="^(staging\.)?pluraldynamics\.com$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Tell the app whether the visitor used HTTPS (secure login cookie, correct links). -->
        <rule name="NodeApp-HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^on$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" />
        </rule>
        <rule name="NodeApp-HTTP" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" />
        </rule>
      </rules>

      <!-- Only the staging address is hidden from search engines; the live domain is indexed. -->
      <outboundRules>
        <rule name="NoIndexStaging">
          <match serverVariable="RESPONSE_X_Robots_Tag" pattern=".*" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^staging\." />
          </conditions>
          <action type="Rewrite" value="noindex, nofollow" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- Let the app's own 404/500 pages through instead of IIS error pages. -->
    <httpErrors existingResponse="PassThrough" />

    <!-- Dashboard image uploads (5 MB images travel as base64). The folder sits under wwwroot,
         so also make sure the app folder, .env and scripts can never be downloaded. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="12582912" />
        <hiddenSegments>
          <add segment="app" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
