# Server settings for the Node.js app (`npm run build && npm start`). Copy to .env and fill in.

# ---------- Dashboard (/admin) ----------
# on (default) or off (/admin returns 404)
ADMIN_DASHBOARD=on
# Login password, at least 8 characters
ADMIN_PASSWORD=test1234
# Long random string that signs the login cookie (changing it signs everyone out)
ADMIN_SESSION_SECRET=f570a1c17c63c6e0540eaca6bb61edb50ef6218f2ccbe918e625f8a04a1960cf

# ---------- MongoDB (blogs, products, images, contact messages) ----------
# Connection string from MongoDB Atlas > Connect > Drivers. Allow the server's IP in Atlas > Network Access.
MONGODB_URI=mongodb+srv://PD:AdmiN@9080@cluster0.egdcj9j.mongodb.net/
MONGODB_DB=pluraldynamics

# ---------- Contact-form email (the contact@ mailbox on the domain's mail host) ----------
SMTP_HOST=smtp.pluraldynamics.com
SMTP_PORT=465
SMTP_USER=contact@pluraldynamics.com
SMTP_PASS=AdmiN@9080
MAIL_FROM=contact@pluraldynamics.com
CONTACT_TO=contact@pluraldynamics.com
# Only if the dashboard's "Send test email" reports a certificate mismatch:
# SMTP_TLS_SERVERNAME=name-on-the-mail-server-certificate
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# ---------- Server ----------
# Port the app listens on (default 3000)
# PORT=3000
