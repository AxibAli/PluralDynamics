# ---------- Server ----------
HOST=0.0.0.0
PORT=1337
# Public URL of this Strapi (Render sets RENDER_EXTERNAL_URL automatically, so this is optional there)
PUBLIC_URL=http://localhost:1337
# The website address(es) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:8080,https://pluraldynamics.com,https://www.pluraldynamics.com

# ---------- Secrets (each a long random string; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" ) ----------
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
# Shared secret between the "Email new leads" webhook and its receiver
WEBHOOK_SECRET=

# ---------- Database: Neon Postgres (Neon > Connect > pooled connection string) ----------
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---------- Images: Cloudinary (Dashboard > API Keys). Leave empty to store uploads locally. ----------
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=pluraldynamics

# ---------- Lead emails (Gmail: an App Password, not your normal password) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where contact-form leads are emailed
CONTACT_TO=contact@pluraldynamics.com

# ---------- One-time import from the old site (remove after the import has run) ----------
MONGODB_URI=
MONGODB_DB=pluraldynamics
